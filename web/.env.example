# ============================================================
#  MSW 街健館 — 環境變數範本
#  用法：cp .env.example .env 後填入真實值
# ============================================================

# ---- 資料庫（與 WordPress 共用 MySQL，但獨立 database: msw_app）----
# 本地 Docker：mysql://msw:msw_app_pw_2026@127.0.0.1:3306/msw_app
# Vercel / 雲端：建議改用 PlanetScale 或 Supabase 的 MySQL/Postgres
DATABASE_URL="mysql://user:password@host:3306/msw_app"

# ---- NextAuth ----
# 正式環境請務必換成隨機長字串：openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me"

# ---- Google OAuth（選用）----
# 1. 到 https://console.cloud.google.com/apis/credentials
# 2. 建立「OAuth 用戶端 ID」→ 類型選「網頁應用程式」
# 3. 已授權的重新導向 URI 填：https://你的網域/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# ---- WordPress ----
NEXT_PUBLIC_WP_URL="http://localhost:8080"
WP_URL="http://localhost:8080"

# ---- 任務規則（修改後需重新啟動）----
NEXT_PUBLIC_MONTHLY_KM_GOAL=300
NEXT_PUBLIC_POINTS_PER_KM=1
NEXT_PUBLIC_TRAINING_POINTS=10
