{
  "name": "msw-street-workout",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "demo:reset": "node scripts/reset-demo.mjs",
    "test:e2e": "node scripts/e2e-test.mjs",
    "test:cms": "node scripts/cms-test.mjs",
    "build:mysql": "prisma generate --schema=prisma/schema.mysql.prisma && next build",
    "db:mysql": "prisma db push --schema=prisma/schema.mysql.prisma",
    "build:postgres": "prisma generate --schema=prisma/schema.postgres.prisma && next build",
    "db:postgres": "prisma db push --schema=prisma/schema.postgres.prisma"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "next": "^14.2.35",
    "next-auth": "^4.24.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
