// MSW 街健館 — 資料庫模型（SQLite 版本）
//
// 用途：免安裝外部資料庫，讓整站可以「單一 Node.js 行程 + 一支 .db 檔案」跑起來，
//       用於雲端沙箱 / 免托管資料庫的平台部署示範。
//
// 正式上線請改用 MySQL 版本：prisma/schema.prisma（provider = "mysql"）
//
// 差異說明：
//   - SQLite 不支援 enum，原本的 Role / RunStatus / CouponStatus 改以 String 儲存，
//     寫入值仍統一由程式碼控制（'MEMBER' | 'ADMIN'、'PENDING' | 'APPROVED' | 'REJECTED'、
//     'UNUSED' | 'USED' | 'EXPIRED'）。
//   - SQLite 不支援 @db.Text / @db.VarChar / @db.Char 等原生型別標註，已移除。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- NextAuth 標準表 ----------
model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- 會員 ----------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String    @default("MEMBER") // MEMBER | ADMIN
  phone         String?
  displayName   String?
  avatarUrl     String?
  bio           String?

  points      Int @default(0)
  totalPoints Int @default(0)

  accounts    Account[]
  sessions    Session[]
  runRecords  RunRecord[]
  checkIns    TrainingCheckIn[]
  coupons     Coupon[]
  pointLogs   PointLog[]
  reviewsMade RunRecord[]          @relation("Reviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

// ---------- 跑步紀錄（上傳截圖 + 輸入公里數）----------
model RunRecord {
  id            String  @id @default(cuid())
  userId        String
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  km            Float
  screenshotUrl String
  periodMonth   String // 所屬月份，例如 "2026-09"
  note          String?
  status        String  @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectReason  String?
  reviewedAt    DateTime?
  reviewerId    String?
  reviewer      User?   @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([userId, periodMonth])
  @@index([status])
  @@index([periodMonth])
}

// ---------- 定期訓練活動簽到（每週一 20:00-21:00）----------
model TrainingCheckIn {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionDate DateTime
  points      Int      @default(10)
  createdAt   DateTime @default(now())

  @@unique([userId, sessionDate])
  @@index([sessionDate])
}

// ---------- 積分明細 ----------
model PointLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int // 正數加分，負數扣分
  reason    String
  refType   String? // RUN / TRAINING / MONTHLY_GOAL / COUPON / MANUAL
  refId     String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------- 優惠券 ----------
model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  discount    String
  periodMonth String
  status      String    @default("UNUSED") // UNUSED | USED | EXPIRED
  usedAt      DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([periodMonth])
}
